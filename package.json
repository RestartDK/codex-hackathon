{
  "name": "codex-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Play by Voice, a conversational gaming companion for blind and low-vision players.",
  "keywords": [],
  "homepage": "https://github.com/RestartDK/codex-hackathon#readme",
  "bugs": {
    "url": "https://github.com/RestartDK/codex-hackathon/issues"
  },
  "license": "MIT",
  "author": "Sparsh Sam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RestartDK/codex-hackathon.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "lint": "vp check --no-fmt",
    "format": "vp fmt --write",
    "typecheck": "tsc -b --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run build",
    "postinstall": "node scripts/copy-stockfish.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.548.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite-plus": "^1.4.0"
  },
  "packageManager": "bun@1.3.13"
}
