{
  "name": "playora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "predev": "node scripts/copy-stockfish.mjs",
    "prebuild": "node scripts/copy-stockfish.mjs",
    "build": "tsc -b && vp build",
    "build:sites": "node scripts/build-sites.mjs",
    "check": "vp check",
    "typecheck": "tsc -b",
    "test": "vp test run --config vitest.config.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "scope-css": "node scripts/scope-css.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.548.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
