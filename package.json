{
  "name": "codex-hackathon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:e2e": "node scripts/run-e2e.mjs",
    "story:check": "node scripts/check-intercept-story.mjs",
    "lint": "vp check --no-fmt",
    "format:check": "vp fmt --check",
    "format": "vp fmt --write",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run story:check && npm run typecheck && npm test && npm run lint && npm run build",
    "postinstall": "node scripts/copy-stockfish.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "nitro": "^3.0.260903-beta",
    "openai": "^7.35.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stockfish": "19.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "vite-plus": "^1.4.0"
  },
  "description": "A voice-first game library for blind and low-vision players.",
  "license": "MIT",
  "author": "Sparsh Sam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RestartDK/codex-hackathon.git"
  },
  "homepage": "https://github.com/RestartDK/codex-hackathon#readme",
  "bugs": {
    "url": "https://github.com/RestartDK/codex-hackathon/issues"
  },
  "keywords": []
}

