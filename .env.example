# Server-only. Never prefix this value with VITE_ or expose it to browser code.
OPENAI_API_KEY=

# Optional model overrides. These defaults match the implementation plan.
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_DELEGATION_MODEL=gpt-6-luna
OPENAI_VOICE=marin
OPENAI_NPC_MODEL=gpt-6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Comma-separated browser origins allowed to create paid voice sessions.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
